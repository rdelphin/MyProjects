# Modenlo - Apache to Node.js Proxy Configuration
# This file routes ALL requests through the Node.js application

# Enable rewrite engine
RewriteEngine On

# Force HTTPS (redirect HTTP to HTTPS)
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Allow Let's Encrypt SSL validation
RewriteCond %{REQUEST_URI} ^/\.well-known/acme-challenge/ [NC]
RewriteRule ^(.*)$ - [L]

# Get the Node.js port from environment (Hostinger sets this automatically)
# Default to port 3000 if not set (for local testing)
RewriteCond %{ENV:PORT} ^$
RewriteRule .* - [E=PORT:3000]

# Proxy all requests to Node.js application
# This routes both static files AND API requests through Node.js
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^(.*)$ http://localhost:%{ENV:PORT}/$1 [P,L]

# Enable proxy and preserve host headers
<IfModule mod_proxy.c>
    ProxyPreserveHost On
    ProxyTimeout 300
</IfModule>
