# Modenlo - Hostinger Node.js Hybrid Deployment (ADVANCED)
# This version includes multiple fallback methods and debugging
# ========================================================================

# Enable rewrite engine with detailed logging
RewriteEngine On

# Uncomment for debugging (check Apache error logs)
# RewriteLog "/tmp/rewrite.log"
# RewriteLogLevel 3

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Redirect www to non-www
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# Allow Let's Encrypt SSL validation
RewriteCond %{REQUEST_URI} ^/\.well-known/acme-challenge/ [NC]
RewriteRule ^(.*)$ - [L]

# ========================================================================
# MULTI-METHOD PORT DETECTION
# ========================================================================

# Method 1: Try environment PORT variable (if Hostinger sets it)
RewriteCond %{ENV:PORT} ^[0-9]+$
RewriteRule .* - [E=NODEJS_PORT:%{ENV:PORT}]

# Method 2: Try common Hostinger port 3000 (default)
RewriteCond %{ENV:NODEJS_PORT} ^$
RewriteRule .* - [E=NODEJS_PORT:3000]

# Method 3: MANUAL OVERRIDE - Uncomment and set if auto-detection fails
# RewriteRule .* - [E=NODEJS_PORT:20045]

# ========================================================================
# STATIC FILE OPTIMIZATION
# ========================================================================

# Serve static files directly from Apache (faster)
RewriteCond %{REQUEST_URI} \.(html|css|js)$ [NC]
RewriteRule ^(.*)$ - [L]

# Serve images directly
RewriteCond %{REQUEST_URI} \.(jpg|jpeg|png|gif|svg|ico|webp)$ [NC]
RewriteRule ^(.*)$ - [L]

# Serve fonts directly
RewriteCond %{REQUEST_URI} \.(woff|woff2|ttf|eot|otf)$ [NC]
RewriteRule ^(.*)$ - [L]

# Serve other common static files
RewriteCond %{REQUEST_URI} \.(pdf|txt|xml|json|csv)$ [NC]
RewriteRule ^(.*)$ - [L]

# ========================================================================
# API PROXY WITH FALLBACK
# ========================================================================

# Primary: Proxy /api/* requests to Node.js
RewriteCond %{REQUEST_URI} ^/api/ [NC]
RewriteRule ^api/(.*)$ http://127.0.0.1:%{ENV:NODEJS_PORT}/api/$1 [P,L,QSA]

# Fallback: Try localhost if 127.0.0.1 fails
RewriteCond %{REQUEST_URI} ^/api/ [NC]
RewriteRule ^api/(.*)$ http://localhost:%{ENV:NODEJS_PORT}/api/$1 [P,L,QSA]

# ========================================================================
# PROXY CONFIGURATION
# ========================================================================

<IfModule mod_proxy.c>
    ProxyPreserveHost On
    ProxyTimeout 300
    ProxyErrorOverride Off
    
    # Connection pooling
    ProxyPass /api/ http://127.0.0.1:3000/api/ retry=0 timeout=300
    ProxyPassReverse /api/ http://127.0.0.1:3000/api/
    
    # Additional proxy settings
    <Proxy *>
        Order deny,allow
        Allow from all
    </Proxy>
</IfModule>

# ========================================================================
# CORS & HEADERS
# ========================================================================

<IfModule mod_headers.c>
    # CORS for API requests
    <FilesMatch "\.(json|xml)$">
        Header set Access-Control-Allow-Origin "*"
        Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, PATCH, OPTIONS"
        Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Session-Id"
    </FilesMatch>
    
    # Handle preflight OPTIONS requests
    <If "%{REQUEST_METHOD} == 'OPTIONS'">
        Header set Access-Control-Allow-Origin "*"
        Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, PATCH, OPTIONS"
        Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Session-Id"
        Header set Access-Control-Max-Age "3600"
        Header set Content-Length "0"
        Header set Content-Type "text/plain"
    </If>
    
    # Security headers
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Performance headers
    <FilesMatch "\.(js|css|jpg|jpeg|png|gif|svg|ico|woff|woff2)$">
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>
</IfModule>

# ========================================================================
# CACHING
# ========================================================================

<IfModule mod_expires.c>
    ExpiresActive On
    # Images
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    # CSS and JavaScript
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    # Fonts
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
</IfModule>

# ========================================================================
# COMPRESSION
# ========================================================================

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ========================================================================
# ERROR HANDLING
# ========================================================================

Options -Indexes
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html
ErrorDocument 502 /502.html
ErrorDocument 503 /503.html

# ========================================================================
# SECURITY
# ========================================================================

# Protect sensitive files
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Protect server config files
<FilesMatch "(^#.*#|\.(bak|config|dist|fla|inc|ini|log|psd|sh|sql|sw[op])|~)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Block access to .env files
<FilesMatch "^\.env">
    Order allow,deny
    Deny from all
</FilesMatch>

