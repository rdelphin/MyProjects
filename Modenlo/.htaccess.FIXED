# Modenlo - Apache to Node.js Proxy Configuration for Hostinger
# FIXED VERSION - Resolves 503 Service Unavailable errors

# Enable rewrite engine
RewriteEngine On

# Force HTTPS (redirect HTTP to HTTPS)
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Allow Let's Encrypt SSL validation (always allow this)
RewriteCond %{REQUEST_URI} ^/\.well-known/acme-challenge/ [NC]
RewriteRule ^(.*)$ - [L]

# OPTION A: Direct proxy without PORT variable (Recommended for Hostinger)
# Hostinger manages the port internally through the Node.js app configuration
# Comment out if using Option B
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^(.*)$ http://127.0.0.1:3000/$1 [P,L]

# OPTION B: Environment variable approach (Alternative)
# Uncomment these lines and comment out Option A if Hostinger requires ENV variables
# RewriteCond %{ENV:PORT} ^$
# RewriteRule .* - [E=PORT:3000]
# RewriteCond %{REQUEST_URI} !^/\.well-known/
# RewriteRule ^(.*)$ http://127.0.0.1:%{ENV:PORT}/$1 [P,L]

# Proxy module configuration
<IfModule mod_proxy.c>
    ProxyPreserveHost On
    ProxyTimeout 600
    ProxyPass /.well-known !
</IfModule>

# Additional proxy settings for better compatibility
<IfModule mod_proxy_http.c>
    ProxyPassReverse / http://127.0.0.1:3000/
</IfModule>

# Error handling
ErrorDocument 503 /503.html
